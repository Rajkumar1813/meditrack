{
  "info": {
    "name": "MediTrack API",
    "_postman_id": "meditrack-api-collection",
    "description": "Postman Collection for MediTrack Online Pharmacy & Inventory OS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Brand",
      "item": [
        {
          "name": "Get Brand Tokens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "If-None-Match",
                "value": "W/\"default\"",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/brand",
              "host": ["{{baseUrl}}"],
              "path": ["brand"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "request"]
            }
          }
        },
        {
          "name": "Verify OTP (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.tokens.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"+919876543210\",\n  \"otp\": \"511241\",\n  \"client\": \"mobile\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"YOUR_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh?client=mobile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"],
              "query": [{ "key": "client", "value": "mobile" }]
            }
          }
        },
        {
          "name": "Current User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog & Search",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Search Suggest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/suggest?q=para",
              "host": ["{{baseUrl}}"],
              "path": ["search", "suggest"],
              "query": [{ "key": "q", "value": "para" }]
            }
          }
        },
        {
          "name": "Browse Medicines",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medicines?limit=20&category=Tablets",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "category", "value": "Tablets" }
              ]
            }
          }
        },
        {
          "name": "Medicine Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medicines/1",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "1"]
            }
          }
        },
        {
          "name": "Same-Salt Generic Alternatives",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/medicines/1/alternatives",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "1", "alternatives"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart & Checkout",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicine_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "Place Order (COD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-order-{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": 1,\n  \"payment_method\": \"cod\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard", "stats"]
            }
          }
        },
        {
          "name": "List Inventory Medicines",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/medicines?page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "medicines"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Expiring Batches (30 Days)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/expiring?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "expiring"],
              "query": [{ "key": "days", "value": "30" }]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\",\n  \"courier\": \"Delhivery\",\n  \"tracking_no\": \"DEL-9842104\",\n  \"note\": \"Dispatched via air express\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "1", "status"]
            }
          }
        }
      ]
    }
  ]
}

