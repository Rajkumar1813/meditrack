# Application
APP_NAME=MediTrack
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:randomGeneratedKeyMustBe32BytesLength!!
JWT_SECRET=super-secret-jwt-key-change-in-production-min32
JWT_TTL=900
JWT_REFRESH_TTL=2592000

# Server Ports
PORT_HTTP=8080
PORT_MYSQL=3306
PORT_REDIS=6379

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meditrack
DB_USERNAME=meditrack
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PREFIX=meditrack:

# Mail (Mailpit for dev)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=support@meditrack.example
MAIL_FROM_NAME=MediTrack

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# SMS (MSG91)
MSG91_AUTH_KEY=msg91_auth_key_placeholder
MSG91_SENDER_ID=MEDTRK
MSG91_OTP_TEMPLATE_ID=template_id_placeholder

# Firebase (FCM)
FIREBASE_CREDENTIALS=storage/firebase-credentials.json

