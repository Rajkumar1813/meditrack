{
  "name": "meditrack/backend",
  "description": "MediTrack Online Pharmacy API (Plain PHP 8.3)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2 || ^8.3",
    "dompdf/dompdf": "^3.0",
    "firebase/php-jwt": "^6.10",
    "kreait/firebase-php": "^7.11",
    "monolog/monolog": "^3.5",
    "nikic/fast-route": "^1.3",
    "phpmailer/phpmailer": "^6.9",
    "predis/predis": "^2.2",
    "razorpay/razorpay": "^2.9",
    "sentry/sentry": "^4.35",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "MediTrack\\": "src/"
    },
    "files": [
      "bootstrap/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MediTrack\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {},
    "audit": {
      "ignore": ["PKSA-y2cr-5h3j-g3ys"]
    }
  }
}
